{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "food-plan.schema.json",
  "title": "FoodPlanFile",
  "type": "object",
  "required": ["plans"],
  "properties": {
    "plans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["person_id", "weeks"],
        "properties": {
          "person_id": { "type": "string" },
          "meals_order": { "type": "array", "items": { "type": "string" } },
          "weeks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "days"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "days": { "type": "object" }
              }
            }
          }
        }
      }
    }
  }
}
